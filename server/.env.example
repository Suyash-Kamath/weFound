# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/wefound

# Long random string used to sign login tokens. Required in production:
# without it the server makes a random one on every start and logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5050
NODE_ENV=development

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Used to build links in password reset emails
FRONTEND_BASE_URL=http://localhost:5173

# Set to false when the server is NOT behind a proxy/load balancer
TRUST_PROXY=true

# No payment provider is connected yet. Set to false to stop handing out
# plan credits for free from the purchase page.
ALLOW_UNPAID_PURCHASES=true

# SMTP for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
